{
  "name": "muse",
  "version": "1.0.0-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:frontend": "vitest run",
    "test": "vitest run && npm run test:bundle-size",
    "test:bundle-size": "node --test scripts/check-bundle-size.test.mjs",
    "test:ci-contract": "node --test scripts/check-ci-contract.test.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "build": "npm run typecheck && vite build && npm run check:bundle-size",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-toast": "^1.2.18",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tauri-apps/cli": "2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
